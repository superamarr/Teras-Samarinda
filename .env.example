# ============================================================
# Environment Configuration Template
# ============================================================
# 1. Salin file ini:  copy .env.example .env
# 2. Sesuaikan nilai di .env (untuk local development)
# 3. Untuk production, buat .env.production (akan dipakai saat npm run build)
#
# Vite otomatis memilih:
#   npm run dev   → baca .env
#   npm run build → baca .env.production (fallback ke .env)
# ============================================================

# === Frontend (Vite) ===
# Development (Laragon)
VITE_API_BASE_URL=http://localPA.test/Teras-Samarinda/backend/public
# Production
# VITE_API_BASE_URL=https://taufikramadhani.web.id/backend/public

# === Backend (PHP — dibaca oleh backend/config/connection.php) ===

# MySQL (sesuaikan dengan database server Anda)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=terassamarinda
DB_USER=root
DB_PASSWORD=

# CORS (pisahkan dengan koma untuk banyak origin, tanpa spasi)
# Development: *
# Production: https://domain-anda.com
CORS_ALLOWED_ORIGINS=*

# Session cookie
# Development (HTTP):  SESSION_SECURE=false  SESSION_SAMESITE=Lax
# Production (HTTPS):   SESSION_SECURE=true   SESSION_SAMESITE=None
SESSION_NAME=tera_admin
SESSION_TIMEOUT=3600
SESSION_SECURE=false
SESSION_HTTP_ONLY=true
SESSION_SAMESITE=Lax
SESSION_PATH=/
SESSION_DOMAIN=
